^https?:\/\/script.hub\/$ url 302 https://scripthub.vercel.app

^https?:\/\/script\.hub\/file\/_start_\/.+type=(?:qx-rewrite|loon-plugin|surge-module|all-module) url script-echo-response https://raw.githubusercontent.com/Lubangqing/QuantumultX-Profile/main/scripts/Script-Hub-Org-Rewrite-Parser.beta.js
^https?:\/\/script\.hub\/file\/_start_\/.+type=rule-set url script-echo-response https://raw.githubusercontent.com/Lubangqing/QuantumultX-Profile/main/scripts/Script-Hub-Org-rule-parser.beta.js
hostname = script.hub,*.script.hub

